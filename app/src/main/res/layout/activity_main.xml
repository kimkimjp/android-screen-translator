<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/Title"
            android:layout_marginTop="0dp"
            android:text="@string/section_permissions" />

        <LinearLayout style="@style/Row">
            <LinearLayout style="@style/RowText">
                <TextView style="@style/Label" android:text="@string/permission_overlay" />
                <TextView android:id="@+id/overlay_status" style="@style/Status" />
            </LinearLayout>
            <Button android:id="@+id/overlay_button" style="@style/RowButton" android:text="@string/grant" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <LinearLayout style="@style/RowText">
                <TextView style="@style/Label" android:text="@string/permission_notification" />
                <TextView android:id="@+id/notification_status" style="@style/Status" />
            </LinearLayout>
            <Button android:id="@+id/notification_button" style="@style/RowButton" android:text="@string/grant" />
        </LinearLayout>

        <TextView style="@style/Title" android:text="@string/section_models" />

        <LinearLayout style="@style/Row">
            <TextView
                android:id="@+id/model_status"
                style="@style/Status"
                android:layout_width="0dp"
                android:layout_weight="1" />
            <Button android:id="@+id/model_button" style="@style/RowButton" android:text="@string/download" />
        </LinearLayout>

        <TextView style="@style/Title" android:text="@string/section_session" />

        <Switch
            android:id="@+id/floating_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/floating_button"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/session_status"
            style="@style/Status"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/session_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/start"
            android:textSize="18sp" />

        <TextView style="@style/Title" android:text="@string/section_usage" />

        <TextView
            style="@style/Status"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/usage" />
    </LinearLayout>
</ScrollView>
